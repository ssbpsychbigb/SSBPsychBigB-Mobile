# Debug: leave LOCAL empty. Metro inlines this PC's Wi-Fi IP automatically.
# Phone and PC must be on the same Wi-Fi. USB is only for installing the app.
#
# Optional override (LAN or https — never 127.0.0.1 on a physical phone):
# API_BASE_URL_LOCAL=http://192.168.1.3:5000/api/v1

API_BASE_URL_PRODUCTION=https://YOUR_API_HOST/api/v1
