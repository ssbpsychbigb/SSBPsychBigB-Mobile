# BIGB Mobile — local configuration notes
# Edit DEV_LAN_IP / ANDROID_USE_EMULATOR in src/shared/constants/config.ts

# Current machine Wi-Fi IP (physical device target):
# API_BASE_URL=http://192.168.29.171:5000/api/v1

# Android emulator:
# API_BASE_URL=http://10.0.2.2:5000/api/v1

# Optional USB tunnel (physical device): adb reverse tcp:5000 tcp:5000
# then you can temporarily point at http://127.0.0.1:5000/api/v1
